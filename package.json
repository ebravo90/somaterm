{
  "name": "somaterm",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "allure:report": "allure generate allure-results --clean && allure open",
    "test:e2e:local": "start-server-and-test dev:mock http://127.0.0.1:5174 'wdio run wdio.conf.ts'",
    "test:e2e:ci": "wdio run wdio.ci.conf.ts",
    "test:unit": "vitest run src",
    "dev:mock": "vite --mode mock --port 5174",
    "prepare": "husky",
    "ci:status": "gh run list -L 5",
    "ci:watch": "gh run watch",
    "ci:logs": "gh run view --log-failed",
    "ci:autofix": "gh run view --log-failed > ci_audit.md",
    "ci:preflight": "timeout 90 gh run watch $(gh run list -L 1 --json databaseId -q '.[0].databaseId') || echo 'Pre-flight complete. Check web for long-running status.'",
    "release:push": "git push origin master --follow-tags"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "autoprefixer": "^10.5.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{css,md}": "prettier --write"
  }
}
